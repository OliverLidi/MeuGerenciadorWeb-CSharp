@page "/"
@inject ProdutoService ProdutoService

<PageTitle>Gerenciador de Estoque</PageTitle>

<h1>Painel de Produtos</h1>

@if (produtos == null)
{
    <p><em>Carregando...</em></p>
}
else
{
    <div class=""mb-3"">
        <strong>Total de Itens:</strong> @produtos.Sum(p => p.QuantidadeEstoque) | 
        <strong>Valor em Estoque:</strong> @produtos.Sum(p => p.ValorTotal).ToString("C")
    </div>

    <table class=""table table-striped"">
        <thead>
            <tr>
                <th>ID</th>
                <th>Nome</th>
                <th>Categoria</th>
                <th>Qtd. Estoque</th>
                <th>Preço Venda</th>
                <th>Valor Total</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in produtos)
            {
                <tr>
                    <td>@p.Id</td>
                    <td>@p.Nome</td>
                    <td>@p.Categoria</td>
                    <td>@p.QuantidadeEstoque</td>
                    <td>@p.PrecoVenda.ToString("C")</td>
                    <td>@p.ValorTotal.ToString("C")</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<Produto>? produtos;

    protected override void OnInitialized()
    {
        produtos = ProdutoService.ObterTodos();
    }
}
