@page "/"
@using MeuGerenciadorWeb
@rendermode InteractiveServer

<PageTitle>Painel de Controle e Estoque</PageTitle>

<div class="container my-4">
    <!-- TÍTULO DO PAINEL -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="text-primary fw-bold mb-1">📊 Painel de Controle e Estoque</h2>
            <p class="text-muted mb-0">Sistema Web em C# / .NET (Blazor) para Gestão de Produtos</p>
        </div>
    </div>

    <!-- CARDS DE INDICADORES (DASHBOARD) -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card bg-primary text-white shadow-sm border-0">
                <div class="card-body">
                    <h6 class="card-title text-uppercase fw-semibold opacity-75">Total de Itens</h6>
                    <h3 class="fw-bold mb-0">@produtos.Sum(p => p.Quantidade) <small class="fs-6 fw-normal">unidades</small></h3>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-success text-white shadow-sm border-0">
                <div class="card-body">
                    <h6 class="card-title text-uppercase fw-semibold opacity-75">Valor Total do Estoque</h6>
                    <h3 class="fw-bold mb-0">@produtos.Sum(p => p.ValorTotal).ToString("C2")</h3>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-dark text-white shadow-sm border-0">
                <div class="card-body">
                    <h6 class="card-title text-uppercase fw-semibold opacity-75">Variedade de Produtos</h6>
                    <h3 class="fw-bold mb-0">@produtos.Count <small class="fs-6 fw-normal">cadastrados</small></h3>
                </div>
            </div>
        </div>
    </div>

    <!-- FORMULÁRIO DE CADASTRO DE NOVO PRODUTO -->
    <div class="card shadow-sm mb-4 border-0">
        <div class="card-header bg-light fw-bold text-secondary">
            ➕ Cadastrar Novo Produto
        </div>
        <div class="card-body">
            <div class="row g-2">
                <div class="col-md-4">
                    <input type="text" class="form-control" placeholder="Nome do produto..." @bind="novoNome" />
                </div>
                <div class="col-md-2">
                    <input type="number" class="form-control" placeholder="Qtd" min="1" @bind="novaQtd" />
                </div>
                <div class="col-md-3">
                    <input type="number" step="0.01" class="form-control" placeholder="Preço (R$)" @bind="novoPreco" />
                </div>
                <div class="col-md-3 d-grid">
                    <!-- BOTÃO ADICIONAR COM EVENTO @onclick -->
                    <button class="btn btn-primary fw-bold" @onclick="AdicionarNovoProduto">
                        ➕ Cadastrar Produto
                    </button>
                </div>
            </div>
            
            <!-- MENSAGEM DE ALERTA -->
            @if (!string.IsNullOrEmpty(mensagem))
            {
                <div class="alert alert-info mt-3 mb-0 py-2 small" role="alert">
                    @mensagem
                </div>
            }
        </div>
    </div>

    <!-- BARRA DE BUSCA E TABELA -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-bold text-dark">Lista de Produtos</h5>
            <div class="w-50">
                <input type="text" class="form-control form-control-sm" placeholder="🔍 Pesquisar por nome..." @bind="termoBusca" @bind:event="oninput" />
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>#ID</th>
                            <th>Produto</th>
                            <th class="text-center">Quantidade</th>
                            <th class="text-end">Preço Un.</th>
                            <th class="text-end">Subtotal</th>
                            <th class="text-center">Ações</th>
                        </tr>
                    </thead>
                    <tbody style="user-select: none;">
                        @foreach (var p in ProdutosFiltrados)
                        {
                            <tr>
                                <td><span class="badge bg-secondary">#@p.Id</span></td>
                                <td class="fw-bold text-dark">@p.Nome</td>
                                
                                <td class="text-center" @onclick:stopPropagation="true">
                                    <div class="btn-group btn-group-sm" role="group">
                                        <button type="button" class="btn btn-outline-secondary fw-bold px-2" @onclick="() => AlterarQuantidade(p, -1)">-</button>
                                        <span class="btn btn-light disabled text-dark fw-bold px-3">@p.Quantidade</span>
                                        <button type="button" class="btn btn-outline-secondary fw-bold px-2" @onclick="() => AlterarQuantidade(p, 1)">+</button>
                                    </div>
                                </td>
                                
                                <td class="text-end">@p.Preco.ToString("C2")</td>
                                <td class="text-end fw-bold text-success">@p.ValorTotal.ToString("C2")</td>
                                
                                <td class="text-center" @onclick:stopPropagation="true">
                                    <button type="button" class="btn btn-outline-danger btn-sm" @onclick="() => RemoverProduto(p)">
                                        🗑️ Excluir
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@code {
    private List<Produto> produtos = new List<Produto>
    {
        new Produto { Id = 1, Nome = "Teclado Mecânico RGB", Quantidade = 2, Preco = 250.00m },
        new Produto { Id = 2, Nome = "Mouse Gamer 16000 DPI", Quantidade = 5, Preco = 120.00m },
        new Produto { Id = 3, Nome = "Monitor 144Hz IPS", Quantidade = 1, Preco = 1299.90m }
    };

    private string novoNome = string.Empty;
    private int novaQtd = 1;
    private decimal novoPreco = 0.00m;
    private string termoBusca = string.Empty;
    private string mensagem = string.Empty;

    private IEnumerable<Produto> ProdutosFiltrados =>
        string.IsNullOrWhiteSpace(termoBusca)
            ? produtos
            : produtos.Where(p => p.Nome.Contains(termoBusca, StringComparison.OrdinalIgnoreCase));

    // LÓGICA DE CADASTRO DO NOVO PRODUTO
    private void AdicionarNovoProduto()
    {
        if (string.IsNullOrWhiteSpace(novoNome))
        {
            mensagem = "⚠️ Por favor, informe o nome do produto!";
            return;
        }

        if (novoPreco <= 0)
        {
            mensagem = "⚠️ O preço do produto deve ser maior que zero!";
            return;
        }

        int proximoId = produtos.Any() ? produtos.Max(p => p.Id) + 1 : 1;

        produtos.Add(new Produto
        {
            Id = proximoId,
            Nome = novoNome,
            Quantidade = novaQtd <= 0 ? 1 : novaQtd,
            Preco = novoPreco
        });

        mensagem = $"✅ Produto '{novoNome}' cadastrado com sucesso!";

        // Limpa o formulário
        novoNome = string.Empty;
        novaQtd = 1;
        novoPreco = 0.00m;
    }

    private void AlterarQuantidade(Produto p, int delta)
    {
        p.Quantidade += delta;
        if (p.Quantidade < 1) p.Quantidade = 1;
    }

    private void RemoverProduto(Produto p)
    {
        produtos.Remove(p);
        mensagem = $"🗑️ Produto '{p.Nome}' removido!";
    }
}