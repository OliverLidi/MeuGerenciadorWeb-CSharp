@page "/"
@inject ProdutoService ProdutoService

<PageTitle>Gerenciador de Estoque</PageTitle>

<h1 class="mb-4">Painel de Produtos</h1>

@if (produtos == null)
{
    <p><em>Carregando...</em></p>
}
else
{
    <div class="card mb-4 p-3 bg-light">
        <div>
            <strong>Total de Itens:</strong> @produtos.Sum(p => p.QuantidadeEstoque) | 
            <strong>Valor em Estoque:</strong> @produtos.Sum(p => p.ValorTotal).ToString("C")
        </div>
    </div>

    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>ID</th>
                <th>Nome</th>
                <th>Categoria</th>
                <th class="text-end">Qtd. Estoque</th>
                <th class="text-end">Preço Venda</th>
                <th class="text-end">Valor Total</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in produtos)
            {
                <tr>
                    <td>@p.Id</td>
                    <td>@p.Nome</td>
                    <td>@p.Categoria</td>
                    <td class="text-end">@p.QuantidadeEstoque</td>
                    <td class="text-end">@p.PrecoVenda.ToString("C")</td>
                    <td class="text-end">@p.ValorTotal.ToString("C")</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<Produto>? produtos;

    protected override void OnInitialized()
    {
        produtos = ProdutoService.ObterTodos();
    }
}
